# 统一换行符，避免"在 Windows 上 clone、拷到 Ubuntu 就报 $'\r': command not found"
* text=auto

*.sh        text eol=lf
*.c         text eol=lf
*.h         text eol=lf
Makefile    text eol=lf
*.mk        text eol=lf
*.dts       text eol=lf
*.dtsi      text eol=lf
*.md        text eol=lf
*.py        text eol=lf
*.ps1       text eol=crlf

*.png       binary
*.jpg       binary
*.pdf       binary
